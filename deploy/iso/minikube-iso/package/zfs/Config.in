config BR2_PACKAGE_ZFS
	bool "zfs"
	depends on BR2_LINUX_KERNEL
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_LIBTIRPC
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBBLKID
	select BR2_PACKAGE_UTIL_LINUX_LIBUUID
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBUDEV
	help
	  OpenZFS is an advanced file system and volume manager.
	  This package provides the ZFS kernel module and userspace tools.

	  https://github.com/openzfs/zfs

comment "zfs needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL

comment "zfs needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
